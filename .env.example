# Postgres (docker-compose)
DATABASE_URL=postgresql://relay:relay@localhost:5432/relay?schema=public
# Redis (docker-compose)
REDIS_URL=redis://localhost:6379
# MinIO / S3-compatible storage (docker-compose)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=relay
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# API
PORT=3001
JWT_SECRET=change-me-in-production
# Comma-separated arbiter emails for dispute rulings
ADMIN_EMAILS=admin@relay.example
# Web app origin (OAuth redirects land here)
WEB_URL=http://localhost:3000

# ZeptoMail — email OTPs. Without these, codes are logged to the API console.
ZEPTO_URL=api.zeptomail.com/
ZEPTO_TOKEN="Zoho-enczapikey your-token"
ZEPTO_FROM=noreply@yourdomain.com
ZEPTO_FROM_NAME=Relay

# Google OAuth — add GOOGLE_CALLBACK_URL to the client's authorised redirect URIs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# Paystack — bank list, account-name resolution, BVN customer validation
PAYSTACK_URL=https://api.paystack.co
PAYSTACK_SECRET_KEY=sk_test_xxx

# 32 random bytes, base64 — encrypts NIN/BVN/account numbers at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
KYC_ENCRYPTION_KEY=

# Webhook shared secrets — callers must send them in the `x-webhook-secret`
# header. Optional in local dev; REQUIRED in production (webhooks reject
# every call when NODE_ENV=production and the secret is unset).
KYC_WEBHOOK_SECRET=
PSP_WEBHOOK_SECRET=

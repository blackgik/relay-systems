{
  "dependencies": {
    "@nestjs/common": "^11",
    "@nestjs/core": "^11",
    "@nestjs/platform-express": "^11",
    "@nestjs/platform-socket.io": "^11",
    "@nestjs/websockets": "^11",
    "@prisma/client": "^6",
    "@relay/shared": "workspace:*",
    "bcryptjs": "^3.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "jsonwebtoken": "^9.0.0",
    "reflect-metadata": "^0.2",
    "rxjs": "^7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/jest": "^29.5.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^22",
    "dotenv-cli": "^8",
    "jest": "^29.5.0",
    "prisma": "^6",
    "ts-jest": "^29.1.0",
    "ts-node": "^10",
    "typescript": "^5"
  },
  "name": "@relay/api",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "dotenv -e ../../.env -- ts-node -T src/main.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "start": "dotenv -e ../../.env -- node dist/main.js",
    "test": "jest",
    "prisma:seed": "dotenv -e ../../.env -- prisma db seed"
  },
  "version": "0.1.0",
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ],
    "testMatch": [
      "**/*.spec.ts"
    ],
    "moduleNameMapper": {
      "^@relay/shared$": "<rootDir>/../../packages/shared/src/index.ts"
    }
  },
  "prisma": {
    "seed": "ts-node -T prisma/seed.ts"
  }
}
